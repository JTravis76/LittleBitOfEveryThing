<!DOCTYPE html>
<html>
<head>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

            table thead tr td {
                font-weight: bold;
            }

            table.table-bordered thead tr td {
                border-spacing: 0px;
                border-bottom: 0.5px solid black;
                padding: 0px;
            }

            table.table-striped tr:nth-child(even) {
                background-color: #f1f1f1;
            }

            table tbody tr td {
                padding: 8px 4px;
            }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .text-soften {
            color: gray;
        }

        .text-size-12 {
            font-size: 12px;
        }
    </style>
</head>
<body>
    <table class="table-bordered table-striped">
        <tbody></tbody>
    </table>
</body>
</html>
