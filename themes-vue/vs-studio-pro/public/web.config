<?xml version="1.0" encoding="utf-8"?>
<configuration>
<system.webServer>
    <staticContent>
        <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        <remove fileExtension=".md" />
        <mimeMap fileExtension=".md" mimeType="text/plain" />
    </staticContent>
</system.webServer>
</configuration>