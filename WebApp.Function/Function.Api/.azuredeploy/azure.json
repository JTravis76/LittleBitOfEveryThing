{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string",
      "metadata": {
        "description": "The environment we're deploying for. Example: dev, tst, stg, prod, etc..."
      }
    },
    "alpha": {
      "type": "bool",
      "defaultValue": true
    },
    "slots": {
      "type": "array",
      "defaultValue": [
        "staging"
      ],
      "metadata": {
        "description": "Array with names for possible environment slots"
      },
      "maxLength": 4
    },
    "skuName": {
      "type": "string",
      "defaultValue": "S1",
      "allowedValues": [
        "F1",
        "D1",
        "B1",
        "B2",
        "B3",
        "S1",
        "S2",
        "S3",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "metadata": {
        "description": "Describes plan's pricing tier and instance size. Check details at https://azure.microsoft.com/en-us/pricing/details/app-service/"
      }
    },
    "skuCapacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Describes plan's instance count"
      }
    },
    "storageAccountType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_RAGRS"
      ],
      "metadata": {
        "description": "Storage Account type"
      }
    }
  },
  "variables": {
    "appPrefix": "lsa-api",
    "phase": "[if(parameters('alpha'), 'alpha', 'prod')]",
    "environment": "[toLower(parameters('environment'))]",
    "location": "[resourceGroup().location]",
    "appServicePlanName": "[concat(variables('appPrefix'), '-plan-', variables('phase'))]",
    "functionAppName": "[concat(variables('appPrefix'), '-', variables('environment'))]",
    "appInsightsName": "[concat(variables('appPrefix'), '-appInsights-', variables('environment'))]",
    "storageAccountName": "[concat(uniqueString(resourceGroup().id, variables('appPrefix'), variables('environment')))]"
  },
  "resources": [
    {
      "apiVersion": "2020-09-01",
      "name": "[variables('appServicePlanName')]",
      "metadata": {
        "comments": "This is the overall hosting plan (App Service Plan) of the function. This specifies the performance tier of the plan."
      },
      "type": "Microsoft.Web/serverfarms",
      "location": "[variables('location')]",
      "tags": {
        "displayName": "HostingPlan"
      },
      "sku": {
        "name": "[parameters('skuName')]",
        "capacity": "[parameters('skuCapacity')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "name": "[variables('storageAccountName')]",
      "metadata": {
        "comments": "This creates a storage account for the function. This is where the actual site/function lives."
      },
      "apiVersion": "2019-06-01",
      "location": "[variables('location')]",
      "kind": "Storage",
      "sku": {
        "name": "[parameters('storageAccountType')]"
      }
    },
    {
      "name": "[variables('appInsightsName')]",
      "type": "Microsoft.Insights/components",
      "metadata": {
        "comments": "Enable Application Insights for the function."
      },
      "apiVersion": "2020-02-02-preview",
      "location": "[variables('location')]",
      "kind": "web",
      "properties": {
        "ApplicationId": "[variables('appInsightsName')]"
      }
    },
    {
      "apiVersion": "2020-09-01",
      "name": "[variables('functionAppName')]",
      "type": "Microsoft.Web/sites",
      "metadata": {
        "comments": "This is the actual base site/function itself."
      },
      "kind": "functionapp",
      "location": "[variables('location')]",
      "dependsOn": [
        "[concat('Microsoft.Web/serverFarms/', variables('appServicePlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "tags": {
        "[concat('hidden-related:', resourceGroup().id, '/providers/Microsoft.Web/serverfarms/', variables('appServicePlanName'))]": "empty",
        "displayName": "FunctionApp"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig":  {
          "alwaysOn": true,
          "healthCheckPath": "/api/HealthCheck",
          "cors": {
            "allowedOrigins": [
              "*"
            ]
          },
          "netFrameworkVersion": "v6.0",
          "appSettings":  [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            }
          ]
        },
        "httpsOnly": true
      }
    },
    {
      "apiVersion": "2020-06-01",
      "type": "Microsoft.Web/sites/slots",
      "name": "[concat(variables('functionAppName'), '/', parameters('slots')[copyIndex()])]",
      "metadata": {
        "comments": "This creates the slots for the site/function. The slot names are passed in as strings with the 'slots' parameter. This resource uses a 'copy' function (see the property below) to iterate over that list of names, using 'copyIndex()' as the index of the slots name array, above for the name of each slot."
      },
      "kind": "app",
      "location": "[variables('location')]",
      "comments": "This specifies the web app slots.",
      "tags": {
        "displayName": "FunctionSlots"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig":  {
          "alwaysOn": true,
          "healthCheckPath": "/api/HealthCheck",
          "cors": {
            "allowedOrigins": [
              "*"
            ]
          },
          "netFrameworkVersion": "v6.0",
          "appSettings":  [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            }
          ]
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/Sites', variables('functionAppName'))]"
      ],
      "copy": {
        "name": "webPortalSlot",
        "count": "[length(parameters('slots'))]"
      }
    }
  ],
  "outputs": {
    "environment": {
      "type": "string",
      "value": "[variables('environment')]"
    },
    "appPrefix": {
      "type": "string",
      "value": "[variables('appPrefix')]"
    },
    "appServicePlanName": {
      "type": "string",
      "value": "[variables('appServicePlanName')]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "appInsightsName": {
      "type": "string",
      "value": "[variables('appInsightsName')]"
    }
  }
}
