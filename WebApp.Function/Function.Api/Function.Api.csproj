<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <RootNamespace>WebAppFunction.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include=".azuredeploy\azure.database.json" />
    <Content Include=".azuredeploy\azure.json" />
    <Content Include=".azuredeploy\azure.settings.json" />
    <Content Include=".azuredeploy\azure.settings.params.json" />
    <Content Include=".azuredeploy\database\package-lock.json" />
    <Content Include=".azuredeploy\database\package.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".azuredeploy\database\config\base.conf" />
    <None Include=".azuredeploy\database\config\environment.conf" />
    <None Include=".azuredeploy\database\config\environment.template.conf" />
    <None Include=".azuredeploy\database\sql\rerun\R__002_GrantorType.sql" />
    <None Include=".azuredeploy\database\sql\rerun\R__001_DynamicConfigurations.sql" />
    <None Include=".azuredeploy\database\sql\versions\V01.02__CreateGrantorType.sql" />
    <None Include=".azuredeploy\database\sql\versions\V01.01__CreateConfiguration.sql" />
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="AutoMapper" Version="12.0.1" />
	<PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
	<PackageReference Include="CsvHelper" Version="30.0.1" />
	<PackageReference Include="DotLiquid" Version="2.2.682" />
	<PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.12" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.12" />
    <PackageReference Include="Microsoft.NET.Sdk.Functions" Version="4.1.3" />
    <PackageReference Include="SendGrid" Version="9.28.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.27.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
