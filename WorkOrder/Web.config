  <connectionStrings>
    <add name="db1" connectionString="Data Source=(LocalDB)\ProjectsV12;Initial Catalog=WorkOrder;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
    <add name="db" connectionString="Data Source=HVSV-SQLEXP;Initial Catalog=WorkOrder;Persist Security Info=True;User ID=sa;Password=H@vchem2011" providerName="System.Data.SqlClient"/>
