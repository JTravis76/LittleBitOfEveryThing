      <smtp deliveryMethod="Network" from="no-reply@altivia.com">
        <network host="localhost"
                 port="25"
                 enableSsl="false"
                 defaultCredentials="true" />
      </smtp>
    </mailSettings>
  </system.net>
  
  <system.codedom>
