<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>
      HTML-to-PDF converter for C# (.NET WkHtmlToPdf wrapper). Generates pretty-looking PDF by HTML template or web page URL. Supports page header/footer, page numbering, custom fonts, javascript execution.
      This package embeds wkhtmltopdf binaries (x86 windows) and they're extracted on first use - you don't need to deploy wkhtmltopdf separately.
    </Description>
    <Authors>Jeremy Travis</Authors>
    <Company>FBP-BWXT</Company>
    <Copyright>2019</Copyright>
    <PackageTags>pdf, html to pdf, core, .net</PackageTags>
    <PackageReleaseNotes>This is a rewrite of the WkHtmlToPdf wrapper from (http://www.nrecosite.com/pdf_generator_net.aspx) to work with Net Core</PackageReleaseNotes>
    <Version>1.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\WkHtmlToPdf.api-ms-win-crt-conio-l1-1-0.dll.gz" />
