<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
      <add key="intervalInSeconds" value="180"/>
      <add key="SourceDir" value="C:\Users\jtravis\Desktop"/>
      <add key="DestDir" value="C:\Users\jtravis\Desktop"/>
      <add key="EmailAddress" value="jtravis@altivia.com; jtravis@havchem.com"/>
      <add key="ServiceMailAddress" value="no-reply@altivia.com"/>
    </appSettings>
  
    <system.net>
      <mailSettings>
        <smtp deliveryMethod="Network" from="no-reply@altivia.com">
          <network host="relay.havchem.com" port="25" enableSsl="false" defaultCredentials="true"/>
        </smtp>
      </mailSettings>
    </system.net>
</configuration>
